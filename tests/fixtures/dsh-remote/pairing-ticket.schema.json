{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jotmo.dev/contracts/dsh-remote/v1/pairing-ticket.schema.json",
  "title": "DSH remote QR pairing ticket",
  "type": "object",
  "additionalProperties": false,
  "required": ["scheme", "version", "environment", "pairing_ref", "challenge", "expires_at", "host_fingerprint", "host_public_signing_key", "host_ephemeral_public_key", "host_signature"],
  "properties": {
    "scheme": {"const": "jotmo-dsh-remote"},
    "version": {"const": 1},
    "environment": {"enum": ["test", "production"]},
    "pairing_ref": {"type": "string", "minLength": 8, "maxLength": 128},
    "challenge": {"type": "string", "pattern": "^[A-Za-z0-9_-]{32,128}$"},
    "expires_at": {"type": "integer", "minimum": 1},
    "host_fingerprint": {"type": "string", "pattern": "^[A-Za-z0-9_-]{32,128}$"},
    "host_public_signing_key": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
    "host_ephemeral_public_key": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
    "host_signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
  }
}
